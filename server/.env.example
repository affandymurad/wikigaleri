# GEMINI_API_KEY: key created in a Google AI Studio project WITHOUT a billing account,
# so it stays on the free tier and can never be charged. On Cloud Run it comes from Secret Manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DAILY_GEMINI_LIMIT: most real Gemini calls per UTC day. Cache hits do not count. Default 300.
DAILY_GEMINI_LIMIT=300

# ALLOWED_ORIGINS: comma-separated origins allowed to call the API. Empty allows any (local development).
ALLOWED_ORIGINS="https://wikigaleri.web.app,https://wikigaleri.firebaseapp.com"

# CACHE_BACKEND: "firestore" (default on Cloud Run) or "memory" (default elsewhere).
# CACHE_BACKEND=memory
