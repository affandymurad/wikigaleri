# VITE_AI_MODE chooses how the browser app reaches Gemini. Set it when you run or build the app.
#   direct (default): the user pastes their own Gemini key in the app. No server is needed.
#   api:              the app calls the WikiGaleri API on Cloud Run at /api/* (see server/README.md).
# In development, Vite proxies /api to http://localhost:8080 (see vite.config.ts).
VITE_AI_MODE=direct
